{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro:floor",
  "small_model": "deepseek/deepseek-v4-flash:floor",
  "model_routing": {
    "code_generation": "deepseek/deepseek-v4-pro:floor",
    "code_review": "deepseek/deepseek-v4-pro:floor",
    "quick_edits": "deepseek/deepseek-v4-flash:floor",
    "analysis": "deepseek/deepseek-v4-pro:floor",
    "chat": "deepseek/deepseek-v4-flash:floor"
  },
  "permission": {
    "external_directory": {
      "$HOME/Documents/obsidian/personal/**": "allow",
      "$HOME/Documents/obsidian/personal/private/**": "deny"
    },
    "read": {
      "*": "allow",
      "$HOME/Documents/obsidian/personal/private/**": "deny"
    },
    "edit": {
      "*": "allow",
      "$HOME/Documents/obsidian/personal/private/**": "deny"
    },
    "glob": {
      "*": "allow",
      "$HOME/Documents/obsidian/personal/private/**": "deny"
    },
    "grep": {
      "*": "allow",
      "$HOME/Documents/obsidian/personal/private/**": "deny"
    },
    "bash": {
      "*": "ask",
      "*private*": "deny"
    }
  }
}
